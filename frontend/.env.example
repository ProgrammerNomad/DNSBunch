# Frontend Environment Variables for DNSBunch
# Copy this file to .env.local and update the values

# Backend API Configuration - Internal proxy mode
NEXT_PUBLIC_API_URL=/api
NEXT_PUBLIC_API_TIMEOUT=30000

# Backend Server URL (used by Next.js API routes to proxy requests)
BACKEND_URL=http://127.0.0.1:5000

# Shared secret for POST /internal/v1/tools/* (must match Python backend)
INTERNAL_API_SECRET=change-me-use-long-random-string

# Bulk DNS health (match backend BULK_MAX_DOMAINS)
BULK_MAX_DOMAINS=50

# --- Auth (Phase 2: passwordless only - no passwords) ---
# Self-hosted PostgreSQL on your VPS (sslmode=require recommended)
DATABASE_URL=postgresql://dnsbunch_app:SECRET@your-vps-host:5432/dnsbunch?schema=public&sslmode=require

# Auth.js - use `openssl rand -base64 32` for AUTH_SECRET
AUTH_SECRET=change-me-use-long-random-string-min-32-chars
# Public site URL (local or Netlify production)
AUTH_URL=http://localhost:3000

# Social OAuth (configure at least one for sign-in)
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
# Optional
AUTH_GITHUB_ID=
AUTH_GITHUB_SECRET=

# Email magic link (Nodemailer) - Zepto Mail recommended
# Zepto: host smtp.zeptomail.com, port 587, user emailapikey, password = Agent Send Mail token
EMAIL_FROM=DNSBunch <noreply@yourdomain.com>
EMAIL_SERVER=smtp://emailapikey:YOUR_ZEPTO_SEND_MAIL_TOKEN@smtp.zeptomail.com:587

# --- Mail tester (Step 7 - no VPS SMTP) ---
MAIL_TESTER_DOMAIN=test.local
MAIL_TESTER_SESSION_TTL_MINUTES=60
MAIL_TESTER_MAX_SESSIONS_PER_IP_HOUR=5
# Local dev: allow .eml upload on /tools/mail-tester
MAIL_TESTER_DEV_INGEST=true
NEXT_PUBLIC_MAIL_TESTER_DEV_INGEST=true
# Optional temp storage for debug (not required)
# MAIL_TESTER_EML_DIR=/tmp/dnsbunch-mail-test
# Future inbound provider webhook (SendGrid/Mailgun parse → POST /api/mail-test/inbound)
# MAIL_TESTER_WEBHOOK_SECRET=

NODE_ENV=development
