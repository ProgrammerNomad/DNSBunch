# Frontend Environment Variables for DNSBunch
# Copy this file to .env.local and update the values

# Backend API Configuration - Internal proxy mode
NEXT_PUBLIC_API_URL=/api
NEXT_PUBLIC_API_TIMEOUT=30000

# Backend Server URL (used by Next.js API routes to proxy requests)
BACKEND_URL=http://127.0.0.1:5000

# Shared secret for POST /internal/v1/tools/* (must match Python backend)
INTERNAL_API_SECRET=change-me-use-long-random-string

# Bulk DNS health (match backend BULK_MAX_DOMAINS)
BULK_MAX_DOMAINS=50

# --- Auth (Phase 2: passwordless only - no passwords) ---
# Self-hosted PostgreSQL on your VPS (sslmode=require recommended)
DATABASE_URL=postgresql://dnsbunch_app:SECRET@your-vps-host:5432/dnsbunch?schema=public&sslmode=require

# Auth.js - use `openssl rand -base64 32` for AUTH_SECRET
AUTH_SECRET=change-me-use-long-random-string-min-32-chars
# Public site URL (local or Netlify production)
AUTH_URL=http://localhost:3000

# Social OAuth (configure at least one for sign-in)
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
# Optional
AUTH_GITHUB_ID=
AUTH_GITHUB_SECRET=

# Email magic link (Nodemailer) - required for email sign-in
EMAIL_FROM=DNSBunch <noreply@yourdomain.com>
EMAIL_SERVER=smtp://user:pass@smtp.yourdomain.com:587

NODE_ENV=development
