# Frontend Environment Variables for DNSBunch
# Copy this file to .env.local and update the values

# Backend API Configuration - Internal proxy mode
# This points to Next.js API routes that proxy to Python backend
NEXT_PUBLIC_API_URL=/api
NEXT_PUBLIC_API_TIMEOUT=30000

# Backend Server URL (used by Next.js API routes to proxy requests)
# For local development
BACKEND_URL=http://127.0.0.1:5000

# Shared secret for POST /internal/v1/tools/* (must match Python backend)
INTERNAL_API_SECRET=change-me-use-long-random-string

# Bulk DNS health (match backend BULK_MAX_DOMAINS)
BULK_MAX_DOMAINS=50
# For production on Netlify, update this to your Python backend URL
# BACKEND_URL=https://your-python-backend.onrender.com

# Development/Production Environment
NODE_ENV=development

# Analytics (Optional)
# NEXT_PUBLIC_GA_ID=GA_MEASUREMENT_ID

# Feature Flags (Optional)
# NEXT_PUBLIC_ENABLE_ANALYTICS=false
# NEXT_PUBLIC_ENABLE_ERROR_REPORTING=false
